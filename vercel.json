{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?be-imports\\.com"
        }
      ],
      "destination": "/beimports/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/beimports",
      "destination": "/beimports/index.html"
    },
    {
      "source": "/beimports/",
      "destination": "/beimports/index.html"
    }
  ],
  "cleanUrls": true
}